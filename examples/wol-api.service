[Unit]
Description=Wake-on-LAN API
After=network-online.target
Wants=network-online.target

[Service]
User=wolapi
Group=wolapi
WorkingDirectory=/opt/wol
EnvironmentFile=/etc/wol-api.env
ExecStart=/opt/wol/.venv/bin/gunicorn --workers 1 --bind ${WOL_BIND_HOST}:${WOL_PORT} server:create_app()
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
